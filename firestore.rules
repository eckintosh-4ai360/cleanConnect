rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // The app has fully migrated to Supabase (Postgres) — see
    // supabase/migrations/ and the Firebase -> Supabase migration plan.
    // Firestore is no longer read or written by any client. These rules
    // were previously wide open (allow read, write: if true) on every
    // collection, which was a real exposure once this repo went public;
    // locked to deny-all now that nothing depends on Firestore access.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
