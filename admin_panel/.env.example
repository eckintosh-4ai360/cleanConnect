# Google Maps browser key for the Live Fleet Map.
# Enable "Maps JavaScript API" on this key in Google Cloud Console and restrict
# it by HTTP referrer — a browser key is fetched by the client and is therefore
# public; the referrer restriction is what actually protects it.
# Copy this file to .env.local (git-ignored) and fill in the value.
VITE_GOOGLE_MAPS_API_KEY=

# Optional. AdvancedMarker requires a Map ID; a cloud-styled Map ID created in
# Google Cloud Console lets you theme the basemap. Leave unset to use the
# built-in DEMO_MAP_ID, which works but shows a "development" watermark.
VITE_GOOGLE_MAPS_MAP_ID=
